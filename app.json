{
  "expo": {
    "name": "TaskBros",
    "slug": "taskbros-app",
    "owner": "sheikhhossainn",
    "scheme": "taskbros",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C10",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sheikhhossainn.taskbrosapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B0C10",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskBros needs access to your photos so you can upload your class or work routine.",
          "cameraPermission": "TaskBros needs access to your camera so you can take a photo of your routine."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C5CE7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a14a93dc-3db1-4cf2-bade-3a8b947219cc"
      },
      "supabaseUrl": "https://dzbwuqnxxpgylkmnuuuw.supabase.co",
      "supabaseAnonKey": "sb_publishable_T68gIfAoyjjySi4QC--bJg_LeehGacl"
    }
  }
}
